<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="garese_pos.GpManagerAuthPopup">
        <Dialog title="props.title" contentClass="'gp-auth-popup'" size="'md'">
            <p t-if="props.body" class="gp-auth-body" t-esc="props.body"/>
            <label class="form-label" for="gp-auth-manager">Manager</label>
            <select id="gp-auth-manager" class="form-select form-select-lg mb-3" t-model.number="state.userId">
                <option value="0" t-att-selected="!state.userId">Choose the manager</option>
                <t t-foreach="props.managers" t-as="manager" t-key="manager.id">
                    <option t-att-value="manager.id" t-esc="manager.name"/>
                </t>
            </select>
            <label class="form-label" for="gp-auth-password">Odoo password of the manager</label>
            <input id="gp-auth-password" t-ref="password" type="password" autocomplete="off"
                   class="form-control form-control-lg" t-model="state.password" t-on-keydown="onKeydown"/>
            <div t-if="state.error" class="gp-auth-error"><i class="fa fa-exclamation-circle me-1"/><t t-esc="state.error"/></div>
            <t t-set-slot="footer">
                <button class="button confirm btn btn-lg btn-primary" t-att-disabled="!canConfirm" t-on-click="() => this.confirm()">
                    <i t-if="state.busy" class="fa fa-circle-o-notch fa-spin me-1"/>
                    <t t-esc="confirmText"/>
                </button>
                <button class="button cancel btn btn-lg btn-secondary" t-on-click="() => this.cancel()">Cancel</button>
            </t>
        </Dialog>
    </t>
</templates>
