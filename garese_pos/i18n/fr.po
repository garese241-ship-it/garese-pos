#. module: garese_pos
#: model:ir.model.fields,help:garese_pos.field_pos_config__gp_close_requires_manager
#: model:ir.model.fields,help:garese_pos.field_res_config_settings__pos_gp_close_requires_manager
msgid ""
"A cashier can only close the session after a manager of the Point of Sale "
"typed his Odoo password on the register. The manager who authorized the "
"closing is recorded on the session."
msgstr ""
"Un caissier ne peut fermer la session qu'après qu'un responsable du point de"
" vente a saisi son mot de passe Odoo sur la caisse. Le responsable qui a "
"autorisé la clôture est enregistré sur la session."

#. module: garese_pos
#: model:ir.model.fields,help:garese_pos.field_pos_config__gp_vip_threshold
#: model:ir.model.fields,help:garese_pos.field_res_config_settings__pos_gp_vip_threshold
msgid ""
"A customer who spent at least this amount in this Point of Sale is flagged "
"VIP. 0 disables the flag."
msgstr ""
"Un client qui a dépensé au moins ce montant dans ce point de vente est "
"signalé VIP. 0 désactive le repère."

#. module: garese_pos
#. odoo-javascript
#: code:addons/garese_pos/static/src/app/cashier_control/cashier_control.js:0
