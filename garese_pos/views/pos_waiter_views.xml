<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="gp_pos_waiter_view_tree" model="ir.ui.view">
        <field name="name">garese.pos.waiter.tree</field>
        <field name="model">garese.pos.waiter</field>
        <field name="arch" type="xml">
            <tree string="Waiters" editable="bottom" sample="1">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="pos_config_ids" widget="many2many_tags" placeholder="All Points of Sale"
                       options="{'no_create': True}"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="order_count"/>
                <button name="action_view_orders" type="object" string="Orders" icon="fa-shopping-bag"
                        invisible="not order_count"/>
                <field name="active" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>

    <record id="gp_pos_waiter_view_search" model="ir.ui.view">
        <field name="name">garese.pos.waiter.search</field>
        <field name="model">garese.pos.waiter</field>
        <field name="arch" type="xml">
            <search string="Waiters">
                <field name="name"/>
                <field name="pos_config_ids"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="gp_pos_waiter_action" model="ir.actions.act_window">
        <field name="name">Waiters</field>
        <field name="res_model">garese.pos.waiter</field>
        <field name="view_mode">tree</field>
        <field name="context">{'active_test': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add the waiters of your Point of Sale</p>
            <p>The cashier selects one of them on each order: the waiter is printed on the receipt and you can analyse the sales per waiter.</p>
        </field>
    </record>

    <menuitem id="gp_menu_pos_waiter" name="Waiters" parent="point_of_sale.menu_point_config_product"
              action="gp_pos_waiter_action" sequence="12" groups="point_of_sale.group_pos_manager"/>

    <!-- Waiter on the orders -->
    <record id="gp_view_pos_order_tree_waiter" model="ir.ui.view">
        <field name="name">pos.order.tree.garese.pos.waiter</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_order_tree"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="gp_waiter_id" optional="show"/>
            </field>
        </field>
    </record>

    <record id="gp_view_pos_order_filter_waiter" model="ir.ui.view">
        <field name="name">pos.order.search.garese.pos.waiter</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_order_filter"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="gp_waiter_id"/>
            </field>
            <filter name="config_id" position="after">
                <filter string="Waiter" name="gp_waiter" domain="[]" context="{'group_by': 'gp_waiter_id'}"/>
            </filter>
        </field>
    </record>

    <!-- Sales analysis per waiter -->
    <record id="gp_view_report_pos_order_search_waiter" model="ir.ui.view">
        <field name="name">report.pos.order.search.garese.pos.waiter</field>
        <field name="model">report.pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_report_pos_order_search"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="gp_waiter_id"/>
            </field>
            <filter name="pos" position="after">
                <filter string="Waiter" name="gp_waiter" context="{'group_by': 'gp_waiter_id'}"/>
            </filter>
        </field>
    </record>
</odoo>
