<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="gp_product_template_form_view" model="ir.ui.view">
        <field name="name">product.template.form.garese.pos</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="point_of_sale.product_template_form_view"/>
        <field name="arch" type="xml">
            <field name="pos_categ_ids" position="after">
                <field name="gp_pos_favorite" invisible="not available_in_pos"/>
            </field>
        </field>
    </record>

    <!-- Brand: general product form, list and search (when the option is on) -->
    <record id="gp_product_template_form_brand" model="ir.ui.view">
        <field name="name">product.template.form.garese.brand</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <field name="categ_id" position="after">
                <field name="gp_brand_id" groups="garese_pos.gp_group_brand"/>
            </field>
        </field>
    </record>

    <record id="gp_product_template_tree_brand" model="ir.ui.view">
        <field name="name">product.template.tree.garese.brand</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view"/>
        <field name="arch" type="xml">
            <field name="categ_id" position="after">
                <field name="gp_brand_id" optional="show" groups="garese_pos.gp_group_brand"/>
            </field>
        </field>
    </record>

    <record id="gp_product_template_search_brand" model="ir.ui.view">
        <field name="name">product.template.search.garese.brand</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_search_view"/>
        <field name="arch" type="xml">
            <field name="categ_id" position="after">
                <field name="gp_brand_id" groups="garese_pos.gp_group_brand"/>
            </field>
            <filter name="group_by_categ_id" position="after">
                <filter name="gp_group_brand" string="Brand" context="{'group_by': 'gp_brand_id'}"
                        groups="garese_pos.gp_group_brand"/>
            </filter>
        </field>
    </record>

    <record id="gp_product_template_search_view" model="ir.ui.view">
        <field name="name">product.template.search.garese.pos</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="point_of_sale.product_template_search_view_pos"/>
        <field name="arch" type="xml">
            <filter name="filter_to_availabe_pos" position="after">
                <filter name="gp_filter_pos_favorite" string="POS Favorites"
                        domain="[('gp_pos_favorite', '=', True)]"/>
            </filter>
        </field>
    </record>
</odoo>
