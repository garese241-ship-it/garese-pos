<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="gp_pos_payment_method_view_form" model="ir.ui.view">
        <field name="name">pos.payment.method.form.garese.pos</field>
        <field name="model">pos.payment.method</field>
        <field name="inherit_id" ref="point_of_sale.pos_payment_method_view_form"/>
        <field name="arch" type="xml">
            <field name="split_transactions" position="before">
                <field name="gp_ask_reference"/>
                <field name="gp_color"/>
                <field name="gp_icon" placeholder="fa-mobile"/>
            </field>
        </field>
    </record>

    <record id="gp_pos_payment_method_view_tree" model="ir.ui.view">
        <field name="name">pos.payment.method.tree.garese.pos</field>
        <field name="model">pos.payment.method</field>
        <field name="inherit_id" ref="point_of_sale.pos_payment_method_view_tree"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="gp_ask_reference" optional="show"/>
            </field>
        </field>
    </record>
</odoo>
