<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="garese_pos.GpBagButton">
        <button class="control-button btn btn-light rounded-0 fw-bolder gp-bag-button" t-on-click="() => pos.gpAddBag()">
            <i class="fa fa-shopping-bag me-1" role="img" aria-label="Bag" title="Bag"/>
            Bag
        </button>
    </t>

    <t t-name="garese_pos.GpWaiterButton">
        <button class="control-button btn btn-light rounded-0 fw-bolder gp-waiter-button"
                t-att-class="{ 'gp-waiter-set': waiterName }" t-on-click="() => pos.gpSelectWaiter()">
            <i class="fa fa-id-badge me-1" role="img" aria-label="Waiter" title="Waiter"/>
            <t t-if="waiterName" t-esc="waiterName"/>
            <t t-else="">Waiter</t>
        </button>
    </t>

    <t t-name="garese_pos.GpEnterCodeButton">
        <button class="control-button btn btn-light rounded-0 fw-bolder gp-code-button" t-on-click="() => pos.gpEnterCode()">
            <i class="fa fa-barcode me-1" role="img" aria-label="Enter a code" title="Enter a code"/>
            Enter a code
        </button>
    </t>

</templates>
