<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <!-- Closing: the cashier counts the cash, totals are hidden -->
    <t t-name="garese_pos.ClosePosPopupTotals" t-inherit="point_of_sale.ClosePosPopup" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('close-pos-popup')]" position="attributes">
            <attribute name="t-att-class">{ 'gp-totals-hidden': props.gp_show_totals === false }</attribute>
        </xpath>
        <xpath expr="//div[hasclass('total-orders')]" position="attributes">
            <attribute name="t-if">props.gp_show_totals !== false</attribute>
        </xpath>
        <xpath expr="//thead//th[2]" position="attributes">
            <attribute name="t-if">props.gp_show_totals !== false</attribute>
        </xpath>
        <xpath expr="//thead//th[4]" position="attributes">
            <attribute name="t-if">props.gp_show_totals !== false</attribute>
        </xpath>
        <xpath expr="//td[@t-esc='env.utils.formatCurrency(props.default_cash_details.amount)']" position="attributes">
            <attribute name="t-if">props.gp_show_totals !== false</attribute>
        </xpath>
        <xpath expr="//td[contains(@t-esc, 'getDifference(props.default_cash_details.id)')]" position="attributes">
            <attribute name="t-if">props.gp_show_totals !== false</attribute>
        </xpath>
        <xpath expr="//tbody[hasclass('cash-overview')]" position="attributes">
            <attribute name="t-if">props.gp_show_totals !== false</attribute>
        </xpath>
        <!-- bank amounts stay prefilled (no difference posted) but are not shown -->
        <xpath expr="//tbody[@t-if='props.other_payment_methods.length > 0']" position="attributes">
            <attribute name="t-if">props.other_payment_methods.length > 0 and props.gp_show_totals !== false</attribute>
        </xpath>
        <xpath expr="//div[hasclass('modal-footer-right')]" position="attributes">
            <attribute name="t-if">props.gp_show_totals !== false</attribute>
        </xpath>
        <xpath expr="//main[hasclass('modal-body')]" position="before">
            <div t-if="props.gp_show_totals === false" class="gp-totals-note">
                <i class="fa fa-info-circle me-2"/>Count the cash in the drawer and type the amount. The totals are reserved to managers.
            </div>
        </xpath>
    </t>

    <!-- Top bar: no sales report for cashiers, no way to the back-office -->
    <t t-name="garese_pos.NavbarCashierControl" t-inherit="point_of_sale.Navbar" t-inherit-mode="extension">
        <xpath expr="//SaleDetailsButton" position="attributes">
            <attribute name="t-if">hardwareProxy.printer and !pos.gpHideTotals</attribute>
        </xpath>
        <xpath expr="//li[hasclass('backend-button')]" position="attributes">
            <attribute name="t-att-class">pos.gpCashierOnly ? 'd-none' : ''</attribute>
        </xpath>
    </t>
</templates>
