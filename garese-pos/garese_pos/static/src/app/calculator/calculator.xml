<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="garese_pos.GpCalculator">
        <div class="gp-calculator">
            <div class="gp-calc-head">
                <span>Calculator</span>
                <button t-if="props.onClose" type="button" class="gp-calc-close"
                        t-on-click="props.onClose" aria-label="Close" title="Close">
                    <i class="fa fa-times"/>
                </button>
            </div>
            <div class="gp-calc-display" t-esc="display"/>
            <div class="gp-calc-keys">
                <button t-foreach="keys" t-as="k" t-key="k.key" type="button"
                        class="gp-calc-key"
                        t-att-class="{
                            'gp-calc-fn': k.type === 'fn',
                            'gp-calc-op': k.type === 'op',
                            'gp-calc-eq': k.type === 'eq',
                            'gp-calc-wide': k.wide,
                            'active': isActive(k),
                        }"
                        t-on-click="() => this.onKey(k.key)">
                    <i t-if="k.icon" t-attf-class="fa {{k.icon}}"/>
                    <t t-else="" t-esc="k.label"/>
                </button>
            </div>
        </div>
    </t>

</templates>
