<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <!-- ============================================================== -->
    <!-- Product screen: cart header, totals, pads                      -->
    <!-- Only targeted extensions: the anchors used by other modules    -->
    <!-- (Orderline, OrderWidget details slot, pay button...) are kept. -->
    <!-- ============================================================== -->
    <t t-name="garese_pos.ProductScreen" t-inherit="point_of_sale.ProductScreen" t-inherit-mode="extension">

        <xpath expr="//div[hasclass('product-screen')]" position="attributes">
            <attribute name="t-att-class">{ 'd-none': !props.isShown, 'gp-screen': !ui.isSmall }</attribute>
        </xpath>

        <!-- Cart title + the control buttons, moved above the lines -->
        <xpath expr="//OrderWidget" position="before">
            <t t-if="!ui.isSmall">
                <div class="gp-cart-header">
                    <span class="gp-cart-icon"><i class="fa fa-shopping-cart"/></span>
                    <span class="gp-cart-title">Cart</span>
                    <span class="gp-cart-count" t-esc="gpItemCountLabel"/>
                    <button t-if="gpCanClearCart" type="button" class="gp-cart-clear" t-on-click="gpClearCart">
                        <i class="fa fa-trash-o"/> Empty
                    </button>
                </div>
                <div class="control-buttons gp-top-buttons" t-if="gpTopControlButtons.length">
                    <t t-foreach="gpTopControlButtons" t-as="cb" t-key="cb.name">
                        <t t-component="cb.component" t-key="cb.name"/>
                    </t>
                </div>
            </t>
        </xpath>
        <xpath expr="//div[hasclass('pads')]/div[hasclass('control-buttons')]" position="replace"/>

        <!-- Lines: picture, +/- and delete (see garese_pos.Orderline) -->
        <xpath expr="//Orderline" position="attributes">
            <attribute name="line">gpLineData(line)</attribute>
        </xpath>

        <!-- Totals -->
        <xpath expr="//div[hasclass('pads')]" position="before">
            <div t-if="!ui.isSmall" class="gp-summary">
                <t t-set="gpSum" t-value="gpSummary"/>
                <div class="gp-summary-row">
                    <span><i class="fa fa-calculator"/> Subtotal</span>
                    <span class="gp-summary-subtotal" t-esc="gpSum.subtotal"/>
                </div>
                <div class="gp-summary-row" t-att-class="{ 'gp-has-discount': gpSum.hasDiscount }">
                    <span><i class="fa fa-tag"/> Discount</span>
                    <span class="gp-summary-discount" t-esc="gpSum.discount"/>
                </div>
                <div class="gp-summary-row">
                    <span><i class="fa fa-percent"/> Taxes<t t-if="gpSum.taxRate"> (<t t-esc="gpSum.taxRate"/>)</t></span>
                    <span class="gp-summary-tax" t-esc="gpSum.tax"/>
                </div>
                <div class="gp-summary-total">
                    <span>Total</span>
                    <span class="gp-summary-total-value" t-esc="gpSum.total"/>
                </div>
            </div>
        </xpath>

        <!-- Left column buttons (customer note, quotation...) and calculator -->
        <xpath expr="//ActionpadWidget" position="inside">
            <t t-set-slot="gp-side">
                <t t-foreach="gpSideControlButtons" t-as="cb" t-key="cb.name">
                    <t t-component="cb.component" t-key="cb.name"/>
                </t>
            </t>
        </xpath>
        <xpath expr="//Numpad" position="after">
            <GpCalculator t-if="!ui.isSmall and pos.gpShowCalculator"
                          onClose="() => pos.gpToggleCalculator()"/>
        </xpath>
    </t>

    <!-- ============================================================== -->
    <!-- Action pad: walk-in label + room for the side buttons           -->
    <!-- ============================================================== -->
    <t t-name="garese_pos.ActionpadWidget" t-inherit="point_of_sale.ActionpadWidget" t-inherit-mode="extension">
        <xpath expr="//button[hasclass('set-partner')]//div[@t-else]" position="replace">
            <div t-else="" class="fw-bolder text-truncate">Walk-in Customer</div>
        </xpath>
        <xpath expr="//button[hasclass('set-partner')]" position="after">
            <div t-if="props.slots and props.slots['gp-side']" class="gp-side-buttons control-buttons">
                <t t-slot="gp-side"/>
            </div>
        </xpath>
    </t>

    <!-- ============================================================== -->
    <!-- Order line: only when the screen provides `line.gp`             -->
    <!-- (receipts, ticket screen and customer display are untouched)    -->
    <!-- ============================================================== -->
    <t t-name="garese_pos.Orderline" t-inherit="point_of_sale.Orderline" t-inherit-mode="extension">
        <xpath expr="//li[hasclass('orderline')]" position="attributes">
            <attribute name="t-attf-class">{{ line.comboParent ? 'border-start border-3 ms-4' : '' }} {{ line.gp ? 'gp-orderline' : '' }}</attribute>
        </xpath>
        <xpath expr="//li[hasclass('orderline')]/div[1]" position="before">
            <div t-if="line.gp" class="gp-ol-img">
                <img t-if="line.gp.imageUrl" t-att-src="line.gp.imageUrl" t-att-alt="line.productName"/>
                <i t-else="" class="fa fa-cube"/>
            </div>
        </xpath>
        <xpath expr="//ul[hasclass('info-list')]" position="before">
            <div t-if="line.gp" class="gp-ol-controls">
                <span class="gp-ol-unit" t-esc="line.unitPrice"/>
                <div t-if="line.gp.canStep" class="gp-ol-stepper">
                    <button type="button" class="gp-ol-step gp-ol-minus" t-on-click.stop="line.gp.onMinus" aria-label="Decrease quantity" title="Decrease quantity">
                        <i class="fa fa-minus"/>
                    </button>
                    <span class="gp-ol-qty" t-esc="line.gp.qtyLabel"/>
                    <button type="button" class="gp-ol-step gp-ol-plus" t-on-click.stop="line.gp.onPlus" aria-label="Increase quantity" title="Increase quantity">
                        <i class="fa fa-plus"/>
                    </button>
                </div>
                <span t-else="" class="gp-ol-qty gp-ol-qty-fixed">× <t t-esc="line.gp.qtyLabel"/></span>
                <span t-if="line.gp.unitLabel" class="gp-ol-uom" t-esc="line.gp.unitLabel"/>
            </div>
        </xpath>
        <xpath expr="//ul[hasclass('info-list')]" position="after">
            <button t-if="line.gp" type="button" class="gp-ol-remove" t-on-click.stop="line.gp.onRemove" aria-label="Remove line" title="Remove line">
                <i class="fa fa-trash-o"/>
            </button>
        </xpath>
    </t>

</templates>
