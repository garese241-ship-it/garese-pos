<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Users: cashier without back-office -->
    <record id="gp_view_users_form_cashier_only" model="ir.ui.view">
        <field name="name">res.users.form.garese.pos.cashier.only</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='access_rights']/group[1]" position="before">
                <group string="GARESE POS" groups="point_of_sale.group_pos_manager,base.group_erp_manager">
                    <field name="gp_pos_cashier_only"/>
                </group>
            </xpath>
        </field>
    </record>

    <!-- Sessions: who authorized the closing -->
    <record id="gp_view_pos_session_form_closing_auth" model="ir.ui.view">
        <field name="name">pos.session.form.garese.closing.auth</field>
        <field name="model">pos.session</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_session_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='stop_at']" position="after">
                <field name="gp_closing_authorized_by_id" invisible="not gp_closing_authorized_by_id"
                       widget="many2one_avatar_user"/>
            </xpath>
        </field>
    </record>
</odoo>
